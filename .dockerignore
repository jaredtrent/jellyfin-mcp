# Keep the build context minimal — only Go sources are needed for `go build .`.

# VCS
.git
.gitignore

# Build / release artifacts
/jellyfin-mcp
dist/
build/
**/*.tar.gz
**/*.tgz
**/*.zip
**/*.exe
**/*.test
**/*.out

# npm packaging (not used by the Docker build)
npm/
**/node_modules/

# CI, docs, and meta
.github/
README.md
CHANGELOG.md
CONTRIBUTING.md
RELEASING.md
docker-compose.yml

# Secrets / local env
**/.env
**/.env.*
**/.envrc
**/.npmrc
**/*.pem
**/*.key

# Editor / OS / tooling
.vscode/
.idea/
**/*.swp
**/*.swo
**/*~
**/.DS_Store
**/Thumbs.db
**/*.log
