# Environment variables for jellyfin-mcp.
# Copy this file to .env and fill in your values. Never commit .env.

# Jellyfin API Key (required)
# Dashboard > Advanced > API Keys
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# Jellyfin server URL, such as http://YOUR_SERVER:8096, or https://YOUR_SERVER:8920 only if HTTPS is turned on in Jellyfin
JELLYFIN_URL=http://YOUR_SERVER:8096

# Jellyfin user that user-scoped calls act as (optional): a user ID or a
# username. Without it, an API key acts as the first administrator.
# JELLYFIN_USER_ID=

# Time zone for today's date and for the dates in tool inputs and results
# (optional; defaults to the system time zone, which is UTC in the Docker image)
# TZ=America/New_York

# Bearer token for HTTP transport / docker-compose (required when binding a
# non-localhost address). Generate a long random secret.
# HTTP_TOKEN=
